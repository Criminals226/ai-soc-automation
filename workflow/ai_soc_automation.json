    {
      "parameters": {
        "jsCode": "const reputation = $json.data;\n\nreturn [\n  {\n    json: {\n      alert_id: $('SOC Alert Webhook').first().json.body.alert_id,\n      alert_type: $('SOC Alert Webhook').first().json.body.alert_type,\n      original_severity: $('SOC Alert Webhook').first().json.body.severity,\n      source_ip: $('SOC Alert Webhook').first().json.body.source_ip,\n      destination: $('SOC Alert Webhook').first().json.body.destination,\n      username: $('SOC Alert Webhook').first().json.body.username,\n      timestamp: $('SOC Alert Webhook').first().json.body.timestamp,\n      description: $('SOC Alert Webhook').first().json.body.description,\n\n      threat_intelligence: {\n        abuse_confidence_score: reputation.abuseConfidenceScore,\n        is_tor: reputation.isTor,\n        is_whitelisted: reputation.isWhitelisted,\n        country: reputation.countryCode,\n        isp: reputation.isp,\n        domain: reputation.domain,\n        total_reports: reputation.totalReports,\n        distinct_reporters: reputation.numDistinctUsers,\n        last_reported_at: reputation.lastReportedAt\n      }\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
