    {
      "parameters": {
        "promptType": "define",
        "text": "=You are an AI SOC analyst.\n\nAnalyze the security alert and threat intelligence below.\n\nReturn a JSON object with exactly these fields:\n\n{\n  \"verdict\": \"TRUE_POSITIVE\",\n  \"severity\": \"HIGH\",\n  \"confidence\": 0.8,\n  \"reason\": \"Brief evidence-based explanation.\",\n  \"recommended_actions\": [\n    \"Review relevant security logs.\",\n    \"Investigate the affected system.\"\n  ]\n}\n\nRules:\n- verdict: TRUE_POSITIVE or FALSE_POSITIVE\n- severity: LOW, MEDIUM, HIGH, or CRITICAL\n- confidence: number between 0 and 1\n- recommended_actions: 2 to 4 safe investigation or containment actions- recommended_actions: MUST contain 2 to 4 safe investigation or containment actions.\n- recommended_actions MUST NEVER be empty, even when verdict is FALSE_POSITIVE.\n- For FALSE_POSITIVE alerts, provide safe actions such as documenting the false positive, reviewing the relevant logs, validating the triggering condition, or monitoring for recurrence.\n- Base your analysis only on the provided information.\n- Do not invent facts.\n- Do not automatically block, delete, disable, or isolate anything.\n- Return only the JSON object.\n- Do not use Markdown or code fences.\n\nSecurity alert and threat intelligence:\n\n{{ JSON.stringify($json) }}",
        "messages": {
          "messageValues": []
        },
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        1120,
        -80
      ],
      "id": "200ac227-62a2-47a1-895e-996d0f822915",
      "name": "AI SOC Analyst"
    },
    {
      "parameters": {
        "jsCode": "const raw = $json.text;\n\nif (!raw) {\n  throw new Error(\"AI SOC Analyst returned an empty response.\");\n}\n\nconst cleaned = raw\n  .replace(/^```json\\s*/i, \"\")\n  .replace(/^```\\s*/i, \"\")\n  .replace(/\\s*```$/i, \"\")\n  .trim();\n\nlet result;\n\ntry {\n  result = JSON.parse(cleaned);\n} catch (error) {\n  throw new Error(\n    \"AI SOC Analyst returned invalid JSON: \" + cleaned\n  );\n}\n\nconst validVerdicts = [\"TRUE_POSITIVE\", \"FALSE_POSITIVE\"];\nconst validSeverities = [\"LOW\", \"MEDIUM\", \"HIGH\", \"CRITICAL\"];\n\nif (!validVerdicts.includes(result.verdict)) {\n  throw new Error(\"Invalid verdict returned by AI.\");\n}\n\nif (!validSeverities.includes(result.severity)) {\n  throw new Error(\"Invalid severity returned by AI.\");\n}\n\nif (\n  typeof result.confidence !== \"number\" ||\n  result.confidence < 0 ||\n  result.confidence > 1\n) {\n  throw new Error(\"Invalid confidence value returned by AI.\");\n}\n\nif (\n  !Array.isArray(result.recommended_actions) ||\n  result.recommended_actions.length === 0\n) {\n  throw new Error(\"No recommended actions returned by AI.\");\n}\n\n// Get the original alert from Prepare SOC Analysis\nconst originalAlert = $('Prepare SOC Analysis').first().json;\n\nreturn [\n  {\n    json: {\n      ...result,\n\n      alert_id: originalAlert.alert_id,\n      alert_type: originalAlert.alert_type,\n      source_ip: originalAlert.source_ip,\n      destination: originalAlert.destination,\n      username: originalAlert.username,\n      timestamp: originalAlert.timestamp,\n\n      validated: true\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
