      "id": "e66baf24-68d4-4f6f-868d-7a0ffef0e3fc",
      "name": "Normalize security alert"
    },
    {
      "parameters": {
        "jsCode": "const alert = $json;\n\nconst text = [\n  alert.source_ip,\n  alert.destination,\n  alert.username,\n  alert.description\n].filter(Boolean).join(\" \");\n\nconst ipRegex = /\\b(?:\\d{1,3}\\.){3}\\d{1,3}\\b/g;\nconst hashRegex = /\\b[a-fA-F0-9]{32,64}\\b/g;\nconst domainRegex = /\\b(?:[a-zA-Z0-9-]+\\.)+[a-zA-Z]{2,}\\b/g;\n\nconst ips = [...new Set(text.match(ipRegex) || [])];\nconst hashes = [...new Set(text.match(hashRegex) || [])];\nconst domains = [...new Set(text.match(domainRegex) || [])];\n\nreturn [{\n  json: {\n    ...alert,\n    iocs: {\n      ips,\n      hashes,\n      domains\n    }\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        -80
      ],
      "id": "9708a2d7-5bf9-4a1f-b6a8-3988eee5ca5c",
      "name": "Extract IOCS"
    },
